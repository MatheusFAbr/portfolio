# Envio do formulário de contato (https://resend.com).
# Este arquivo é um MODELO: mantenha os valores sempre vazios.
# Os valores reais vão em .env.local, que o .gitignore já bloqueia.

# Chave da API do Resend.
RESEND_API_KEY=

# Remetente. Com domínio próprio verificado, use algo como contato@seudominio.com.br.
# Sem domínio, use onboarding@resend.dev — mas atenção: esse remetente de teste
# só entrega para o e-mail dono da conta do Resend.
CONTACT_FROM_EMAIL=

# Destino das mensagens. Opcional: sem ele, usa o e-mail definido em src/constants/site.ts.
# Usando onboarding@resend.dev, este PRECISA ser o e-mail dono da conta do Resend.
CONTACT_TO_EMAIL=
